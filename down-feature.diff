+// ---- ,down implementation ------------------------------------------------------------------------------
+let downRunning = false;
+function scanDownFolder() {
+  fs.mkdirSync(DOWN_DIR, { recursive: true });
+  const now = Date.now();
+  return fs.readdirSync(DOWN_DIR, { withFileTypes: true })
+    .filter(d => d.isFile() && !d.name.startsWith('.'))
+    .map(d => {
+      const full = path.join(DOWN_DIR, d.name);
+      const st = fs.statSync(full);
+      return { name: d.name, full, size: st.size, settled: now - st.mtimeMs >= 3000 };
+    })
+    .sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true }));
+}
+async function runDownFolderUpload(sock, jid) {
+  const target = db.targetGroups.find(g => g.jid === db.selectedGroupJid);
+  if (!target) {
+    await sock.sendMessage(jid, { text: '⚠️ No target group selected. Send ,setgroup in a group, then use ,selectgroup 1. Use ,groups to view saved groups.' });
+    return;
+  }
+  if (downRunning) { await sock.sendMessage(jid, { text: '⏳ A ,down upload is already running. Please wait for it to finish.' }); return; }
+  const files = scanDownFolder();
+  if (!files.length) { await sock.sendMessage(jid, { text: '📂 [MPM] The `down` folder is empty. Put files in it, then send ,down again.' }); return; }
+
+  downRunning = true;
+  const ok = [], failed = [];
+  try {
+    const head = await sock.sendMessage(jid, { text: `📦 [MPM] ${files.length} file(s) found in \`down\`.\n📤 Destination: ${target.name}\n⏳ Starting…` });
+    const say = async (text) => {
+      try { await sock.sendMessage(jid, { text, edit: head.key }); }
+      catch { try { await sock.sendMessage(jid, { text }); } catch {} }
+    };
+    for (let i = 0; i < files.length; i++) {
+      const f = files[i];
+      await say(`⬆️ [MPM] Uploading ${i + 1}/${files.length}\n📄 ${f.name}\n📏 ${bytes(f.size)}\n📤 ${target.name}\n\n✅ ${ok.length}   ❌ ${failed.length}`);
+      try {
+        if (!f.settled) throw new Error('file is still being copied (modified <3s ago)');
+        if (f.size === 0) throw new Error('empty file');
+        if (f.size > UPLOAD_MAX_BYTES) throw new Error('larger than ' + UPLOAD_MAX_TEXT);
+        await waitUploadGap(null);
+        try {
+          await sock.sendMessage(target.jid, { document: { url: f.full }, fileName: f.name, mimetype: mimeTypeFor(f.full) });
+        } finally { markUploadDone(); }
+        // Delete ONLY after WhatsApp accepted the upload.
+        try { await fs.promises.unlink(f.full); } catch (e) { console.error('[down] could not delete', f.name, e.message); }
+        ok.push(f);
+      } catch (e) {
+        console.error('[down] upload failed:', f.name, e.message);
+        failed.push({ name: f.name, reason: String(e.message || e).slice(0, 120) });
+      }
+    }
+    let report = `📊 [MPM] *down* finished\n📤 Destination: ${target.name}\n✅ Uploaded & deleted: ${ok.length}\n❌ Failed (kept in folder): ${failed.length}`;
+    if (failed.length) report += '\n\n' + failed.map(f => `• ${f.name} — ${f.reason}`).join('\n');
+    await say(report);
+  } finally { downRunning = false; }
+}
